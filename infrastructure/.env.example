# Copia este fichero a .env y ajusta los valores para tu entorno
# Este fichero SÍ se comitea; .env NO se comitea (gitignoreado)

# IP o hostname de la máquina donde corre la app
# Local:       192.168.1.176
# Raspberry:   192.168.1.171
API_HOST=

# Hostname MagicDNS de Tailscale (obtener con: tailscale status --json | python3 -c "import sys,json; d=json.load(sys.stdin); print(d['Self']['DNSName'])")
# Ejemplo: genzo.tailbbc079.ts.net
TAILSCALE_HOSTNAME=
